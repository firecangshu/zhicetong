/* pages/w6-redline/index.wxss */
/* W6 法规红线页面样式 */

.redline-page {
  min-height: 100vh;
  background: #0a0e1a;
  padding-bottom: 160rpx;
}

/* ========= 步骤条 ========= */
.step-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #14182b;
  border-bottom: 1rpx solid #E8ECF0;
  overflow-x: auto;
  white-space: nowrap;
}

.step-item {
  display: flex;
  align-items: center;
  opacity: 0.4;
}

.step-item.active {
  opacity: 1;
}

.step-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #C8C8CC;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
}

.step-item.active .step-num {
  background: #00D4FF;
}

.step-label {
  font-size: 22rpx;
  color: #A0A8B8;
}

.step-item.active .step-label {
  color: #00D4FF;
  font-weight: 600;
}

.step-arrow {
  margin: 0 8rpx;
  color: #C8C8CC;
  font-size: 24rpx;
}

/* ========= 页面头部 ========= */
.page-header {
  padding: 32rpx 32rpx 16rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #A0A8B8;
}

.data-source-badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  background: #E8F4FD;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #00D4FF;
}

/* ========= 内容容器 ========= */
.page-container {
  padding: 0 24rpx 40rpx;
}

/* ========= 三区三线状态卡片 ========= */
.zone-status-section {
  padding: 24rpx 24rpx 0;
}

.zone-status-section .section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.zone-card {
  display: flex;
  align-items: flex-start;
  background: #14182b;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  border-left: 8rpx solid #C8C8CC;
}

.zone-card.zone-danger {
  border-left-color: #E53935;
  background: linear-gradient(135deg, #FFF8F0 0%, #FFFFFF 100%);
}

.zone-card.zone-warning {
  border-left-color: #F5A623;
  background: linear-gradient(135deg, #FFF8F0 0%, #FFFFFF 100%);
}

.zone-card.zone-safe {
  border-left-color: #00B365;
  background: linear-gradient(135deg, #F0FFF4 0%, #FFFFFF 100%);
}

.zone-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.zone-info {
  flex: 1;
}

.zone-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 4rpx;
}

.zone-line {
  display: block;
  font-size: 22rpx;
  color: #A0A8B8;
  margin-bottom: 8rpx;
}

.zone-status {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.zone-desc {
  display: block;
  font-size: 22rpx;
  color: #A0A8B8;
  line-height: 1.6;
}

/* ========= 区块卡片 ========= */
.section-card {
  background: #14182b;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

/* ========= 三区三线条目 ========= */
.redline-item {
  padding: 20rpx 16rpx;
  margin-bottom: 16rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  position: relative;
}

.redline-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.redline-value {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.redline-value.safe {
  color: #00B365;
}

.redline-value.warning {
  color: #F5A623;
}

.redline-value.danger {
  color: #E53935;
}

/* ========= 行业法规条目 ========= */
.reg-item {
  padding: 20rpx 16rpx;
  margin-bottom: 16rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
  position: relative;
}

.reg-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.reg-requirement {
  font-size: 26rpx;
  color: #A0A8B8;
  line-height: 1.6;
}

/* ========= 来源标签 ========= */
.source-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  margin-top: 8rpx;
  margin-right: 8rpx;
}

.source-tag.official {
  background: #E8F4FD;
  color: #00D4FF;
}

.source-tag.ai {
  background: #E8F7ED;
  color: #00B365;
}

/* ========= 编辑图标 ========= */
.edit-icon {
  position: absolute;
  top: 20rpx;
  right: 16rpx;
  font-size: 28rpx;
  color: #C8C8CC;
}

/* ========= 人工备注 ========= */
.manual-note {
  display: block;
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #FFF8F0;
  border-left: 6rpx solid #F5A623;
  border-radius: 0 8rpx 8rpx 0;
  font-size: 24rpx;
  color: #8C6900;
  line-height: 1.6;
}

/* ========= 警示框 ========= */
.alert-box {
  padding: 24rpx 20rpx;
  background: #FFF8F0;
  border-radius: 12rpx;
  border-left: 8rpx solid #F5A623;
  margin-bottom: 24rpx;
}

.alert-text {
  font-size: 26rpx;
  color: #8C6900;
  line-height: 1.6;
}

/* ========= 确认区域 ========= */
.confirm-section {
  margin-top: 40rpx;
  padding: 32rpx 24rpx;
  background: #14182b;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.confirm-checkbox {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 3rpx solid #C8C8CC;
  margin-right: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFFFFF;
  transition: all 0.2s;
}

.checkbox.checked {
  background: #00D4FF;
  border-color: #00D4FF;
}

.confirm-text {
  font-size: 26rpx;
  color: #FFFFFF;
  line-height: 1.6;
}

.next-btn {
  width: 100%;
  height: 88rpx;
  background: #C8C8CC;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 12rpx;
  border: none;
  line-height: 88rpx;
}

.next-btn:not(.disabled) {
  background: #00D4FF;
}

.next-btn.disabled {
  background: #C8C8CC;
}

/* ========= V2.2.0 精修覆盖层（发光+玻璃态+胶囊按钮+白色步骤） ========= */
page .step-bar-scroll { background: #0a0e1a !important; }
page .step-item.active .step-num { background: #FFFFFF !important; color: #0a0e1a !important; }
page .step-item.active .step-label { color: #FFFFFF !important; font-weight: 700 !important; }
page .page-title, page .section-title { text-shadow: 0 0 10px rgba(0, 212, 255, 0.3), 0 0 30px rgba(0, 212, 255, 0.1) !important; }
page .zone-card, page .section-card { background: rgba(20, 24, 43, 0.6) !important; border: 1px solid rgba(0, 212, 255, 0.15) !important; box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.05) !important; }
page .data-source-badge { background: rgba(0, 212, 255, 0.1) !important; border: 1px solid rgba(0, 212, 255, 0.2) !important; }
page .next-btn { border-radius: 48rpx !important; background: linear-gradient(135deg, rgba(0, 212, 255, 0.15) 0%, rgba(0, 136, 204, 0.15) 100%) !important; color: #00D4FF !important; border: 1px solid rgba(0, 212, 255, 0.3) !important; box-shadow: 0 0 15px rgba(0, 212, 255, 0.15) !important; }
