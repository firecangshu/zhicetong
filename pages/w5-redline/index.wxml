<!--pages/w5-redline/index.wxml-->
<!--W5 法规红线 V2.8 全量预埋版-->
<view class="redline-page">
  <!-- 步骤条 -->
    <scroll-view scroll-x class="step-bar-scroll" enhanced show-scrollbar="{{false}}">

    <view class="step-bar">

      <view class="step-item"><view class="step-num">W1</view><text class="step-label">地块</text></view>

      <text class="step-arrow">→</text>

      <view class="step-item"><view class="step-num">W2</view><text class="step-label">资源</text></view>

      <text class="step-arrow">→</text>

      <view class="step-item"><view class="step-num">W3</view><text class="step-label">政策</text></view>

      <text class="step-arrow">→</text>

      <view class="step-item"><view class="step-num">W4</view><text class="step-label">市场</text></view>

      <text class="step-arrow">→</text>

      <view class="step-item active"><view class="step-num">W5</view><text class="step-label">法规</text></view>

      <text class="step-arrow">→</text>

      <view class="step-item"><view class="step-num">W6</view><text class="step-label">SWOT</text></view>

      <text class="step-arrow">→</text>

      <view class="step-item"><view class="step-num">W7</view><text class="step-label">需求</text></view>

      <text class="step-arrow">→</text>

      <view class="step-item"><view class="step-num">W8</view><text class="step-label">定位</text></view>

      <text class="step-arrow">→</text>

      <view class="step-item"><view class="step-num">W9</view><text class="step-label">成果</text></view>

    </view>

  </scroll-view>

  <view class="page-header">
    <text class="page-title">W5 法规红线</text>
    <text class="page-subtitle">三区三线 · 国土空间规划约束</text>
    <view class="data-source-badge">📋 全量预埋 V2.8</view>
  </view>

  <!-- 三区三线状态卡片 -->
  <view class="zone-status-section">
    <view class="section-title">🚧 三区三线状态卡</view>
    <view class="zone-card {{item.status.indexOf('❌') !== -1 ? 'zone-danger' : item.status.indexOf('⚠️') !== -1 ? 'zone-warning' : 'zone-safe'}}"
      wx:for="{{zoneStatusCards}}" wx:key="zone">
      <view class="zone-icon">{{item.status.indexOf('❌') !== -1 ? '🚫' : item.status.indexOf('⚠️') !== -1 ? '⚠️' : '✅'}}</view>
      <view class="zone-info">
        <view class="zone-name">{{item.zone}}</view>
        <view class="zone-line">{{item.line}}</view>
        <view class="zone-status" style="color:{{item.color}}">{{item.status}}</view>
        <view class="zone-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="page-container">
    <!-- 三区三线 -->
    <view class="section-card">
      <view class="section-title">🗺️ 三区三线</view>

      <view class="redline-item" wx:for="{{threeLinesList}}" wx:key="key" bindtap="onEditLine" data-key="{{item.key}}">
        <view class="redline-label">{{item.label}}</view>
        <view class="redline-value {{item.value.indexOf('✅') !== -1 ? 'safe' : 'danger'}}">
          {{item.value}}
        </view>
        <view class="source-tag {{item.sourceType === 'official_api' ? 'official' : 'ai'}}">
          {{item.sourceType === 'official_api' ? '官方API' : 'AI聚合'}}
        </view>
        <view class="manual-note" wx:if="{{item.manualNote}}">
          <text class="note-icon">📝</text>
          <text class="note-text">{{item.manualNote}}</text>
          <text class="note-edit" catchtap="onEditLine" data-key="{{item.key}}">✏️</text>
        </view>
      </view>
    </view>

    <!-- 行业法规 -->
    <view class="section-card">
      <view class="section-title">📋 行业法规要求</view>

      <view class="reg-item" wx:for="{{industryRegulations}}" wx:key="name" bindtap="onEditReg" data-index="{{index}}">
        <view class="reg-name">{{item.name}}</view>
        <view class="reg-requirement">{{item.requirement}}</view>
        <view class="source-tag {{item.sourceType === 'official_api' ? 'official' : 'ai'}}">
          {{item.sourceType === 'official_api' ? '官方API' : 'AI聚合'}}
        </view>
        <view class="manual-note" wx:if="{{item.manualNote}}">
          <text class="note-icon">📝</text>
          <text class="note-text">{{item.manualNote}}</text>
          <text class="note-edit" catchtap="onEditReg" data-index="{{index}}">✏️</text>
        </view>
      </view>
    </view>

    <!-- 确认按钮 -->
    <view class="confirm-section">
      <view class="confirm-checkbox" bindtap="onToggleConfirm">
        <view class="checkbox {{isConfirmed ? 'checked' : ''}}">
          <text wx:if="{{isConfirmed}}">✓</text>
        </view>
        <text class="confirm-text">{{confirmText}}</text>
      </view>
      <button class="next-btn {{isConfirmed ? '' : 'disabled'}}" bindtap="onNext" disabled="{{!isConfirmed}}">
        确认并继续 →
      </button>
    </view>
  </view>
</view>
