/* pages/s3-role/index.wxss */
/* S2 身份选择页 - 暗色科技风 */

page {
  background: #0a0e1a;
  height: 100%;
}

/* ========= 页面容器 ========== */
.role-page {
  min-height: 100vh;
  background: #0a0e1a;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: env(safe-area-inset-bottom);
  position: relative;
}

/* ========= 主内容区 ========== */
.main-content {
  width: 100%;
  padding: 60rpx 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  padding-top: calc(env(safe-area-inset-top) + 80rpx);
}

/* ========= 标题区 ========== */
.title-area {
  text-align: center;
  margin-bottom: 56rpx;
}
.app-name {
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
  margin-bottom: 8rpx;
  letter-spacing: 4rpx;
}
.app-title {
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 6rpx;
  line-height: 1.3;
  text-shadow:
    0 0 20rpx rgba(0, 212, 255, 0.5),
    0 0 40rpx rgba(0, 212, 255, 0.25),
    0 0 80rpx rgba(26, 109, 255, 0.15);
}
.app-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.35);
  margin-top: 14rpx;
  letter-spacing: 2rpx;
}

/* ========= 身份选项列表 ========== */
.role-list {
  width: 100%;
  margin-bottom: 32rpx;
}
.role-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(255,255,255,0.07);
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  transition: all 0.2s;
  background: transparent;
}
.role-item.active {
  border-color: rgba(26,109,255,0.35);
  background: rgba(26,109,255,0.06);
}
.role-emoji { font-size: 36rpx; margin-right: 20rpx; flex-shrink: 0; }
.role-info { flex: 1; }
.role-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #e0e0e0;
  margin-bottom: 4rpx;
}
.role-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
}
.role-check {
  width: 34rpx; height: 34rpx; border-radius: 50%;
  background: #1A6DFF; color: #fff; font-size: 20rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 0 10rpx rgba(26,109,255,0.3);
}

/* ========= 确认按钮（描边风）========== */
.btn-confirm {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: transparent;
  border: 2rpx solid #00D4FF;
  color: #00D4FF;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 4rpx;
  padding: 0;
}
.btn-confirm::after { border: none; }
.btn-confirm[disabled] {
  border-color: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.15);
  background: rgba(255,255,255,0.03);
}
