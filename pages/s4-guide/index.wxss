/* pages/s4-guide/index.wxss */
/* S4 使用指南页面样式 V2.8 视觉增强版（含时间轴）*/

/* 步骤条 */
.step-bar { display: flex; align-items: center; justify-content: center; padding: 24rpx 32rpx 0; background: #1A6DFF; }
.step-item { display: flex; flex-direction: column; align-items: center; }
.step-num { width: 44rpx; height: 44rpx; border-radius: 50%; background: rgba(255,255,255,0.3); color: #fff; font-size: 22rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 6rpx; }
.step-item.active .step-num { background: #fff; color: #1A6DFF; font-weight: bold; }
.step-label { font-size: 20rpx; color: rgba(255,255,255,0.7); }
.step-item.active .step-label { color: #fff; font-weight: 500; }
.step-arrow { color: rgba(255,255,255,0.4); font-size: 28rpx; margin: 0 12rpx; margin-bottom: 24rpx; }

.guide-page {
  min-height: 100vh;
  background: #F5F7FA;
}

.page-container {
  padding: 24rpx 24rpx 160rpx;
}

/* ========= 顶部英雄卡片 ========= */
.hero-card {
  background: linear-gradient(160deg, #1A6DFF 0%, #8C6BFF 100%);
  border-radius: 20rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 32rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(26, 109, 255, 0.25);
}

.hero-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.hero-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* ========= 通用卡片 ========= */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* ========= 段落标题 ========= */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 32rpx;
  background: #1A6DFF;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

/* ========= 时间轴 ========= */
.timeline {
  padding-left: 8rpx;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  position: relative;
  padding-bottom: 28rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #E8ECF0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  position: relative;
  z-index: 1;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.dot-num {
  font-size: 24rpx;
  font-weight: 700;
  color: #8C8C8C;
}

.dot-first {
  background: #1A6DFF;
  box-shadow: 0 4rpx 16rpx rgba(26, 109, 255, 0.4);
}
.dot-first .dot-num {
  color: #FFFFFF;
}

.dot-last {
  background: #00B365;
  box-shadow: 0 4rpx 16rpx rgba(0, 179, 101, 0.4);
}
.dot-last .dot-num {
  color: #FFFFFF;
}

.timeline-line {
  position: absolute;
  left: 25rpx;
  top: 52rpx;
  width: 4rpx;
  height: calc(100% - 20rpx);
  background: linear-gradient(180deg, #1A6DFF 0%, #E8ECF0 100%);
  z-index: 0;
}

.timeline-content {
  flex: 1;
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  min-height: 52rpx;
}

.timeline-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  gap: 12rpx;
}

.timeline-phase {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.timeline-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.tag-blue {
  background: #E8F4FD;
  color: #1A6DFF;
}

.tag-green {
  background: #E8F7ED;
  color: #00B365;
}

.tag-orange {
  background: #FFF3E0;
  color: #F5A623;
}

.tag-red {
  background: #FFEBEE;
  color: #E53935;
}

.tag-purple {
  background: #F0EBFF;
  color: #8C6BFF;
}

.timeline-desc {
  display: block;
  font-size: 22rpx;
  color: #8C8C8C;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.timeline-pages {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.page-chip {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8ECF0;
  border-radius: 6rpx;
  color: #555555;
}

/* ========= 数据规则 ========= */
.rule-box {
  margin-bottom: 20rpx;
}

.rule-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.rule-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rule-dot.blue { background: #1A6DFF; }
.rule-dot.orange { background: #F5A623; }
.rule-dot.green { background: #00B365; }

.rule-text {
  font-size: 28rpx;
  color: #1A1A2E;
}

.rule-note {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #F8F9FA;
  border-radius: 8rpx;
}

/* ========= 确认机制说明 ========= */
.confirm-note-box {
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.confirm-note-item {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.note-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.note-text {
  font-size: 24rpx;
  color: #555555;
  line-height: 1.6;
}

/* ========= 法律声明 ========= */
.notice-box {
  background: #FFF8E6;
  border: 1rpx solid #FFE4A0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin: 20rpx 24rpx;
  font-size: 24rpx;
  color: #F5A623;
  line-height: 1.6;
}

.legal-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.7;
}

/* ========= 开始按钮 ========= */
.btn-next {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #1A6DFF 0%, #8C6BFF 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 16rpx;
  border: none;
  line-height: 96rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 109, 255, 0.3);
  margin-top: 16rpx;
}

.btn-next::after {
  border: none;
}

/* ========= 水印 ========= */
.watermark {
  position: fixed;
  bottom: 24rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: #C8C8CC;
  z-index: 999;
}
