/* pages/s4-guide/index.wxss */
/* S4 使用指南页面样式 - 暗色科技风 V3.0 */

/* ========= 页面容器 ========== */
.guide-page {
  min-height: 100vh;
  background: #0a0e1a;
}

.page-container {
  padding: 32rpx 24rpx 160rpx;
  box-sizing: border-box;
}

/* ========= 英雄卡片（磨砂玻璃）========== */
.hero-card {
  background: linear-gradient(135deg, rgba(26,109,255,0.15) 0%, rgba(0,212,255,0.08) 100%);
  border: 1rpx solid rgba(26,109,255,0.2);
  border-radius: 20rpx;
  padding: 48rpx 36rpx;
  margin-bottom: 32rpx;
  backdrop-filter: blur(10px);
}

.hero-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.hero-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
  text-shadow: 0 0 20rpx rgba(0,212,255,0.3);
}

.hero-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

/* ========= 通用卡片（磨砂玻璃）========== */
.card {
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  backdrop-filter: blur(10px);
}

/* ========= 段落标题 ========== */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #e0e0e0;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 32rpx;
  background: #1A6DFF;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

/* ========= 时间轴 ========== */
.timeline {
  padding-left: 8rpx;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  position: relative;
  padding-bottom: 28rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  position: relative;
  z-index: 1;
  border: 4rpx solid rgba(255,255,255,0.05);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.dot-num {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.35);
}

.dot-first {
  background: #1A6DFF;
  box-shadow: 0 4rpx 16rpx rgba(26,109,255,0.4);
}
.dot-first .dot-num {
  color: #FFFFFF;
}

.dot-last {
  background: #00D4FF;
  box-shadow: 0 4rpx 16rpx rgba(0,212,255,0.4);
}
.dot-last .dot-num {
  color: #FFFFFF;
}

.timeline-line {
  position: absolute;
  left: 25rpx;
  top: 52rpx;
  width: 4rpx;
  height: calc(100% - 20rpx);
  background: linear-gradient(180deg, #1A6DFF 0%, rgba(255,255,255,0.08) 100%);
  z-index: 0;
}

.timeline-content {
  flex: 1;
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  min-height: 52rpx;
}

.timeline-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  gap: 12rpx;
}

.timeline-phase {
  font-size: 26rpx;
  font-weight: 700;
  color: #e0e0e0;
}

.timeline-tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.timeline-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.45);
  line-height: 1.6;
  margin-bottom: 8rpx;
}

/* ========= 数据规则 ========== */
.rule-box {
  margin-bottom: 20rpx;
}

.rule-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  flex-wrap: nowrap;
}

.rule-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rule-text {
  font-size: 28rpx;
  color: #e0e0e0;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.rule-tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid;
  flex-shrink: 0;
}

.rule-note {
  font-size: 22rpx;
  color: rgba(255,255,255,0.35);
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: rgba(255,255,255,0.03);
  border-radius: 8rpx;
}

/* ========= 确认机制说明 ========== */
.confirm-note-box {
  background: rgba(255,255,255,0.03);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.confirm-note-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.note-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.note-text {
  font-size: 28rpx;
  color: #e0e0e0;
  line-height: 1.6;
}

/* ========= 法律声明 ========== */
.notice-box {
  background: rgba(255,179,26,0.06);
  border: 1rpx solid rgba(255,179,26,0.15);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin: 20rpx 24rpx;
}

.legal-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.45);
  line-height: 1.7;
}

/* ========= 开始按钮（描边风）========== */
.btn-next {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: transparent;
  border: 2rpx solid #00D4FF;
  color: #00D4FF;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  box-sizing: border-box;
}
.btn-next::after { border: none; }

.btn-next::after {
  border: none;
}

/* ========= 水印 ========== */
.watermark {
  position: fixed;
  bottom: 24rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255,255,255,0.12);
  z-index: 999;
}
