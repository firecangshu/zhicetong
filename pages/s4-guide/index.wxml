<!--pages/s4-guide/index.wxml-->
<!--S4 工作流程说明页 - 暗色科技风-->
<view class="guide-page">
  <scroll-view scroll-y class="page-container">
    <!-- 标题区 -->
    <view class="hero-card">
      <view class="hero-icon">📋</view>
      <view class="hero-title">工作流程</view>
      <view class="hero-subtitle">了解标准SOP十步流程，开始文旅项目研判</view>
    </view>

    <!-- 时间轴：工作流程 -->
    <view class="card">
      <view class="section-title">工作流程</view>
      <view class="timeline">
        <view class="timeline-item" wx:for="{{timelineSteps}}" wx:key="step">
          <view class="timeline-dot {{index === 0 ? 'dot-first' : index === timelineSteps.length - 1 ? 'dot-last' : ''}}">
            <text class="dot-num">{{item.step}}</text>
          </view>
          <view class="timeline-line" wx:if="{{index < timelineSteps.length - 1}}"></view>
          <view class="timeline-content">
            <view class="timeline-header">
              <text class="timeline-phase">{{item.phase}}</text>
              <text class="timeline-tag" style="color:{{item.tagColor}};border-color:{{item.tagColor}};background:{{item.tagBg}};">{{item.tag}}</text>
            </view>
            <view class="timeline-desc">{{item.desc}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 数据规则 -->
    <view class="card">
      <view class="section-title">数据规则</view>
      <view class="rule-box">
        <view class="rule-item">
          <view class="rule-dot" style="background:#7EC8E3;"></view>
          <text class="rule-text">1. 官方API</text>
          <text class="rule-tag" style="color:#7EC8E3;border-color:#7EC8E3;background:rgba(126,200,227,0.13);">最优</text>
        </view>
        <view class="rule-item">
          <view class="rule-dot" style="background:#A8E6CF;"></view>
          <text class="rule-text">2. AI聚合</text>
          <text class="rule-tag" style="color:#A8E6CF;border-color:#A8E6CF;background:rgba(168,230,207,0.13);">次优</text>
        </view>
        <view class="rule-item">
          <view class="rule-dot" style="background:#FFD3B6;"></view>
          <text class="rule-text">3. 人工补录</text>
          <text class="rule-tag" style="color:#FFD3B6;border-color:#FFD3B6;background:rgba(255,211,182,0.13);">补充</text>
        </view>
      </view>
      <view class="rule-note">{{dataRule}}</view>
    </view>

    <!-- 确认机制说明 -->
    <view class="card">
      <view class="section-title">确认机制</view>
      <view class="confirm-note-box">
        <view class="confirm-note-item">
          <view class="note-dot" style="background:#7EC8E3;"></view>
          <text class="note-text">每页底部有「我已核对」复选框</text>
        </view>
        <view class="confirm-note-item">
          <view class="note-dot" style="background:#A8E6CF;"></view>
          <text class="note-text">可点击数据项手动修正或添加备注</text>
        </view>
        <view class="confirm-note-item">
          <view class="note-dot" style="background:#FFD3B6;"></view>
          <text class="note-text">未勾选确认无法进入下一步</text>
        </view>
      </view>
    </view>

    <!-- 开始按钮 -->
    <button class="btn-next" bindtap="onConfirmAndNext">确认并继续</button>
  </scroll-view>
</view>
