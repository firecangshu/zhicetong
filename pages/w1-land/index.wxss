/* pages/w1-land/index.wxss */
/* W1 地块框选 V3.2 信息汇总版 */

/* ========= 页面基础 ========= */
.land-page {
  min-height: 100vh;
  background: #0a0e1a;
}

.page-header {
  padding: 24rpx 32rpx 16rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
}

.page-subtitle {
  font-size: 26rpx;
  color: #A0A8B8;
  margin-top: 8rpx;
  display: block;
}

.data-source-badge {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #00D4FF;
  background: #1e2335;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.page-container {
  padding: 0 24rpx 40rpx;
}

/* ========= 步骤条（已验证通过，禁止修改） ========= */
.step-bar-scroll { white-space: nowrap; padding: 16rpx 24rpx; background: #14182b; }
.step-bar { display: inline-flex; align-items: center; }
.step-item { display: flex; flex-direction: column; align-items: center; margin: 0 8rpx; }
.step-item.active .step-num { background: #00D4FF; color: #FFFFFF; }
.step-item.active .step-label { color: #00D4FF; font-weight: 700; }
.step-num { width: 56rpx; height: 56rpx; border-radius: 50%; background: #1e2335; color: #A0A8B8; font-size: 22rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.step-label { font-size: 20rpx; color: #A0A8B8; margin-top: 6rpx; }
.step-arrow { color: #3a4160; font-size: 24rpx; margin: 0 4rpx; }

/* ========= 地图组件 ========= */
.map-section {
  margin-top: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #14182b;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.real-map {
  width: 100%;
  height: 480rpx;
}

.map-toolbar {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: #14182b;
  border-top: 1rpx solid #E8ECF0;
}

.map-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  color: #00D4FF;
  background: #1e2335;
  border: none;
  border-radius: 8rpx;
  padding: 0 8rpx;
}

.map-btn.primary {
  background: #00D4FF;
  color: #FFFFFF;
}

.map-btn::after {
  border: none;
}

.map-info {
  font-size: 22rpx;
  color: #00D4FF;
  text-align: center;
  padding: 8rpx 0 16rpx;
  background: #1e2335;
}

/* ========= 折叠式坐标列表 ========= */
.coord-section {
  background: #14182b;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
  overflow: hidden;
}

.coord-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #00D4FF 0%, #0088cc 100%);
}

.coord-section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.coord-icon {
  font-size: 32rpx;
}

.coord-count {
  font-size: 24rpx;
  font-weight: 400;
  opacity: 0.85;
  margin-left: 4rpx;
}

.coord-toggle {
  font-size: 24rpx;
  color: #FFFFFF;
  opacity: 0.9;
}

.coord-list {
  background: #14182b;
  transition: max-height 0.3s ease;
}

.coord-list.collapsed {
  max-height: 0;
  overflow: hidden;
}

.coord-list.expanded {
  max-height: 2000rpx;
}

.coord-item-row {
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx;
  border-bottom: 1rpx solid #F0F4FF;
}

.coord-item-row:last-child {
  border-bottom: none;
}

.coord-index {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #00D4FF;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.coord-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
}

.coord-detail:active {
  background: #1e2335;
}

.coord-lat, .coord-lng {
  font-size: 22rpx;
  font-family: 'JetBrains Mono', 'Courier New', monospace;
  color: #FFFFFF;
}

.coord-delete {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #E53935;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ========= 地块信息汇总卡片 ========= */
.summary-card {
  background: #14182b;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
  overflow: hidden;
}

.summary-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #00B365 0%, #33CC85 100%);
}

.summary-icon {
  font-size: 32rpx;
}

.summary-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex: 1;
}

.summary-badge {
  font-size: 20rpx;
  color: #00B365;
  background: #FFFFFF;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.summary-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #F0F4FF;
}

.summary-row:last-child {
  border-bottom: none;
}

.summary-label {
  width: 200rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #A0A8B8;
}

.summary-label-icon {
  font-size: 28rpx;
}

.summary-value {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.summary-main {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.4;
}

.summary-sub {
  font-size: 22rpx;
  color: #A0A8B8;
  line-height: 1.4;
}

/* ========= 详细数据卡片（编辑用） ========= */
.detail-cards {
  margin-bottom: 20rpx;
}

.detail-card {
  background: #14182b;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.detail-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.source-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.source-tag.official {
  color: #00D4FF;
  background: #1e2335;
}

.source-tag.ai {
  color: #8C6BFF;
  background: #F3F0FF;
}

.detail-value {
  font-size: 26rpx;
  color: #A0A8B8;
  line-height: 1.5;
  display: block;
}

.edit-btn-wrap {
  margin-top: 16rpx;
}

.edit-btn {
  display: inline-block;
  font-size: 22rpx;
  color: #A0A8B8;
  background: transparent;
  border: 1rpx solid #3a4160;
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
  line-height: 1.4;
}

.edit-btn::after {
  border: none;
}

/* ========= 确认按钮 ========= */
.confirm-section {
  margin-top: 32rpx;
}

.confirm-checkbox {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #3a4160;
  border-radius: 8rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #00D4FF;
  border-color: #00D4FF;
}

.confirm-text {
  font-size: 26rpx;
  color: #A0A8B8;
}

.next-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #00D4FF;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 12rpx;
  border: none;
}

.next-btn.disabled {
  background: #D1D5DB;
  color: #FFFFFF;
}

.next-btn::after {
  border: none;
}

/* ========= V2.2.0 精修覆盖层（发光+玻璃态+胶囊按钮+白色步骤） ========= */
.step-bar-scroll { background: #0a0e1a !important; }
.step-item.active .step-num { background: #FFFFFF !important; color: #0a0e1a !important; }
.step-item.active .step-label { color: #FFFFFF !important; font-weight: 700 !important; }
.page-title { text-shadow: 0 0 10px rgba(0, 212, 255, 0.3), 0 0 30px rgba(0, 212, 255, 0.1) !important; }
.card, .map-section, .coord-section, .summary-card, .info-card, .swot-card, .demand-card, .position-card, .result-card, .report-card, .resource-card, .policy-card, .market-card, .redline-card { background: rgba(20, 24, 43, 0.6) !important; border: 1px solid rgba(0, 212, 255, 0.15) !important; box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.05) !important; }
.card-title, .summary-title, .coord-section-title { text-shadow: 0 0 8px rgba(0, 212, 255, 0.2) !important; }
.data-source-badge, .summary-badge, .badge { background: rgba(0, 212, 255, 0.1) !important; border: 1px solid rgba(0, 212, 255, 0.2) !important; }
.btn-next { border-radius: 48rpx !important; background: linear-gradient(135deg, rgba(0, 212, 255, 0.15) 0%, rgba(0, 136, 204, 0.15) 100%) !important; color: #00D4FF !important; border: 1px solid rgba(0, 212, 255, 0.3) !important; box-shadow: 0 0 15px rgba(0, 212, 255, 0.15) !important; }
.map-toolbar { background: rgba(20, 24, 43, 0.6) !important; border-top: 1px solid rgba(0, 212, 255, 0.1) !important; }
