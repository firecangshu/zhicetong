/* pages/s1-cover/index.wxss */
/* CSS粒子流动背景 - APK兼容版 */

page, .splash-container {
  width: 100%;
  height: 100vh;
  background: #0a0e1a;
  position: relative;
  overflow: hidden;
}

/* CSS粒子容器 */
.particle-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  overflow: hidden;
}

/* 单个粒子 */
.particle {
  position: absolute;
  border-radius: 50%;
  background: #00D4FF;
  opacity: 0;
  animation: particleFlashMove linear infinite;
  will-change: transform, opacity;
  /* 触发硬件加速 */
  -webkit-transform: translate3d(0, 0, 0);
}

/* 粒子闪烁 + 移动 + 闪现回原位 */
@keyframes particleFlashMove {
  /* 阶段1：在原位闪烁（暗→亮→暗）*/
  0% {
    transform: translate3d(0, 0, 0) scale(0.3);
    opacity: 0;
  }
  8% {
    transform: translate3d(0, 0, 0) scale(1);
    opacity: 0.9;
  }
  16% {
    transform: translate3d(0, 0, 0) scale(1.8);
    opacity: 1;
  }
  25% {
    transform: translate3d(0, 0, 0) scale(1);
    opacity: 0.7;
  }

  /* 阶段2：开始移动（连续流畅轨迹，每5%一帧）*/
  30% {
    transform: translate3d(5vw, 1vh, 0) scale(0.95);
    opacity: 0.85;
  }
  35% {
    transform: translate3d(15vw, 4vh, 0) scale(0.88);
    opacity: 0.8;
  }
  40% {
    transform: translate3d(25vw, 7vh, 0) scale(0.82);
    opacity: 0.78;
  }
  45% {
    transform: translate3d(36vw, 10vh, 0) scale(0.76);
    opacity: 0.75;
  }
  50% {
    transform: translate3d(48vw, 14vh, 0) scale(0.7);
    opacity: 0.72;
  }
  55% {
    transform: translate3d(60vw, 18vh, 0) scale(0.64);
    opacity: 0.68;
  }
  60% {
    transform: translate3d(72vw, 22vh, 0) scale(0.58);
    opacity: 0.64;
  }
  65% {
    transform: translate3d(84vw, 26vh, 0) scale(0.52);
    opacity: 0.6;
  }
  70% {
    transform: translate3d(96vw, 30vh, 0) scale(0.46);
    opacity: 0.55;
  }
  75% {
    transform: translate3d(108vw, 35vh, 0) scale(0.4);
    opacity: 0.5;
  }
  80% {
    transform: translate3d(120vw, 40vh, 0) scale(0.34);
    opacity: 0.4;
  }
  85% {
    transform: translate3d(132vw, 45vh, 0) scale(0.28);
    opacity: 0.3;
  }
  90% {
    transform: translate3d(144vw, 50vh, 0) scale(0.22);
    opacity: 0.2;
  }

  /* 阶段3：即将结束，闪现回原位 */
  95% {
    transform: translate3d(152vw, 55vh, 0) scale(0.15);
    opacity: 0.05;
  }

  /* 100%：动画结束，loop回0% = 闪现回原位 */
  100% {
    transform: translate3d(160vw, 60vh, 0) scale(0.1);
    opacity: 0;
  }
}

/* 渐变遮罩：保护文字可读性 */
/* 小程序不支持 radial-gradient，用半透明纯色 */
.gradient-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  background: rgba(10, 14, 26, 0.5);
  pointer-events: none;
}

/* Content container */
.content-wrapper {
  position: relative;
  z-index: 3;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* Center text block */
.center-text-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 0 48rpx;
}

/* Main title: tight letter-spacing */
.h1 {
  font-size: 88rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
  letter-spacing: -2rpx;
  line-height: 1.1;
  text-shadow: 0 0 30rpx rgba(0, 212, 255, 0.7);
}

/* Subtitle: relaxed letter-spacing */
.subtitle {
  margin-top: 32rpx;
  font-size: 30rpx;
  font-weight: 400;
  color: #8A8F9D;
  text-align: center;
  letter-spacing: 4rpx;
}

/* Version tag capsule */
.version-tag {
  margin-top: 40rpx;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  border: 1px solid rgba(0, 212, 255, 0.4);
  background: rgba(0, 212, 255, 0.1);
}
.version-tag text {
  font-size: 20rpx;
  color: #00D4FF;
  letter-spacing: 2rpx;
}

/* Feature tags */
.feature-tags {
  margin-top: 60rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.feature-tags text {
  font-size: 22rpx;
  color: #6B7280;
  letter-spacing: 2rpx;
}
.tag-dot {
  color: #4A4F5F;
  font-size: 22rpx;
}

/* Footer action area */
.footer-action {
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 40rpx;
  z-index: 10;
}

/* Button: transparent background + blue border */
.btn-enter {
  width: 400rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: transparent;
  border: 2px solid #00D4FF;
  color: #00D4FF;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}
.btn-enter:active {
  background: rgba(0, 212, 255, 0.2);
  transform: scale(0.97);
}

.disclaimer {
  margin-top: 24rpx;
  font-size: 20rpx;
  color: #4A4F5F;
  opacity: 0.6;
}
