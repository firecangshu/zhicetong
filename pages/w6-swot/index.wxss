/* pages/w7-swot/index.wxss */

.page-container {
  padding: 0 0 40rpx;
  background: #0a0e1a;
  min-height: 100vh;
}

/* ========= 页面头部 ========= */
.page-header {
  background: linear-gradient(135deg, #8C6BFF 0%, #6B4DDD 100%);
  padding: 48rpx 40rpx 40rpx;
  color: #FFFFFF;
}
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.page-subtitle {
  font-size: 26rpx;
  opacity: 0.85;
}

/* ========= 四象限卡片网格 ========= */
.grid-section {
  margin: 24rpx 24rpx 0;
  background: #14182b;
  border-radius: 16rpx;
  padding: 28rpx 24rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 20rpx;
}
.section-hint {
  display: block;
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: #1e2335;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #00D4FF;
  line-height: 1.6;
}

/* 2×2 网格容器 */
.swot-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

/* 单个卡片 */
.grid-card {
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 2rpx solid;
}
.card-s { background: rgba(0,179,101,0.06);   border-color: rgba(0,179,101,0.2); }
.card-w { background: rgba(245,166,35,0.06);  border-color: rgba(245,166,35,0.2); }
.card-o { background: rgba(26,109,255,0.06);  border-color: rgba(26,109,255,0.2); }
.card-t { background: rgba(229,57,53,0.06);   border-color: rgba(229,57,53,0.2); }

/* 卡片头部：字母 + 标题 + 图标 */
.grid-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.grid-letter {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
  margin-right: 12rpx;
}
.card-s .grid-letter { color: #00B365; }
.card-w .grid-letter { color: #F5A623; }
.card-o .grid-letter { color: #00D4FF; }
.card-t .grid-letter { color: #E53935; }

.grid-title-group {
  flex: 1;
  min-width: 0;
}
.grid-title-cn {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
}
.grid-title-en {
  font-size: 20rpx;
  color: #A0A8B8;
  line-height: 1.3;
}
.grid-icon {
  font-size: 32rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}

/* 分割线 */
.grid-divider {
  height: 2rpx;
  margin-bottom: 12rpx;
}
.card-s .grid-divider { background: rgba(0,179,101,0.2); }
.card-w .grid-divider { background: rgba(245,166,35,0.2); }
.card-o .grid-divider { background: rgba(26,109,255,0.2); }
.card-t .grid-divider { background: rgba(229,57,53,0.2); }

/* 关键词列表 */
.grid-items {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.grid-item {
  display: flex;
  align-items: center;
}
.grid-item-dot {
  font-size: 16rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.s-dot { color: #00B365; }
.w-dot { color: #F5A623; }
.o-dot { color: #00D4FF; }
.t-dot { color: #E53935; }
.grid-item-text {
  font-size: 24rpx;
  color: #FFFFFF;
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ========= 详细解释卡片区 ========= */
.detail-section {
  margin: 24rpx 24rpx 0;
}

.detail-card {
  background: #14182b;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  margin-bottom: 20rpx;
}

.detail-header {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-left: 8rpx solid transparent;
}
.s-card .detail-header { border-left-color: #00B365; background: rgba(0,179,101,0.04); }
.w-card .detail-header { border-left-color: #F5A623; background: rgba(245,166,35,0.04); }
.o-card .detail-header { border-left-color: #00D4FF; background: rgba(26,109,255,0.04); }
.t-card .detail-header { border-left-color: #E53935; background: rgba(229,57,53,0.04); }

.detail-tag {
  font-size: 26rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  letter-spacing: 2rpx;
}
.s-tag { background: rgba(0,179,101,0.12); color: #00B365; }
.w-tag { background: rgba(245,166,35,0.12); color: #F5A623; }
.o-tag { background: rgba(26,109,255,0.12); color: #00D4FF; }
.t-tag { background: rgba(229,57,53,0.12); color: #E53935; }

.detail-count {
  flex: 1;
  text-align: right;
  font-size: 24rpx;
  color: #A0A8B8;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.detail-arrow {
  font-size: 24rpx;
  color: #A0A8B8;
  transition: transform 0.25s ease;
  flex-shrink: 0;
}
.arrow-up {
  transform: rotate(180deg);
}

/* 卡片内容 */
.detail-body {
  padding: 0 28rpx 20rpx;
  border-top: 1rpx solid #F0F0F0;
}

.detail-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}
.detail-item:last-child {
  border-bottom: none;
}

.item-dot {
  font-size: 20rpx;
  margin-right: 14rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
}
.s-dot { color: #00B365; }
.w-dot { color: #F5A623; }
.o-dot { color: #00D4FF; }
.t-dot { color: #E53935; }

.item-text {
  flex: 1;
  font-size: 27rpx;
  color: #FFFFFF;
  line-height: 1.65;
  word-break: break-all;
}

.item-source {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  margin-left: 10rpx;
}
.src-official { background: #E8F4FD; color: #00D4FF; }
.src-ai      { background: #E8F5E9; color: #00B365; }
.src-manual  { background: #FFF3E0; color: #F5A623; }

.add-btn {
  text-align: center;
  font-size: 26rpx;
  color: #00D4FF;
  padding: 20rpx 0 8rpx;
  border-top: 1rpx dashed #E0E0E0;
  margin-top: 8rpx;
}

/* ========= 确认区 ========= */
.confirm-section {
  margin: 24rpx 24rpx 0;
  background: #14182b;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.confirm-label {
  display: flex;
  align-items: center;
}
.confirm-text {
  font-size: 26rpx;
  color: #FFFFFF;
  margin-left: 12rpx;
  line-height: 1.6;
}

/* ========= 底部操作栏 ========= */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #14182b;
  border-top: 1rpx solid #F0F0F0;
  z-index: 100;
}
.btn-secondary {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 28rpx;
  color: #FFFFFF;
  background: #0a0e1a;
  border-radius: 12rpx;
  border: none;
}
.btn-primary {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 28rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #8C6BFF 0%, #6B4DDD 100%);
  border-radius: 12rpx;
  border: none;
}
.btn-primary[disabled] {
  background: #CCCCCC;
  color: #FFFFFF;
}
