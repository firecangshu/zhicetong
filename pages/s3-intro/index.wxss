/* pages/s3-intro/index.wxss */
/* 与S1/S2统一风格 - 暗色科技风 */

page {
  background: #0a0e1a;
  height: 100%;
}

.intro-page {
  min-height: 100vh;
  background: #0a0e1a;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* ========= 页面容器 ========== */
.page-container {
  height: 100vh;
  padding: 32rpx 32rpx 60rpx;
  box-sizing: border-box;
}

/* ========= 英雄卡片 ========== */
.hero-card {
  background: linear-gradient(135deg, rgba(26,109,255,0.15) 0%, rgba(0,212,255,0.08) 100%);
  border: 1rpx solid rgba(26,109,255,0.2);
  border-radius: 20rpx;
  padding: 48rpx 36rpx;
  margin-bottom: 32rpx;
  backdrop-filter: blur(10px);
}

.hero-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
  text-shadow: 0 0 20rpx rgba(0,212,255,0.3);
}

.hero-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  line-height: 1.6;
}

/* ========= 磨砂玻璃卡片 ========== */
.card {
  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 16rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  backdrop-filter: blur(10px);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

/* ========= 产品介绍正文 ========== */
.intro-text {
  font-size: 30rpx;
  color: #fff;
  line-height: 1.8;
  text-align: justify;
  font-family: "FangSong", "仿宋", "STFangsong", serif;
}

/* ========= 法律声明 ========== */
.notice-box {
  border-left: 6rpx solid #F5A623;
}

.legal-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.45);
  line-height: 1.8;
  text-align: justify;
}

/* ========= 按钮（描边风）========== */
.btn-next {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: transparent;
  border: 2rpx solid #00D4FF;
  color: #00D4FF;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  letter-spacing: 4rpx;
}

.btn-next::after {
  border: none;
}
