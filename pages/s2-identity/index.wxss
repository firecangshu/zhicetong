/* pages/s2-identity/index.wxss */
.identity-page { min-height: 100vh; background: #F5F7FA; padding-bottom: 40rpx; }

/* 步骤条 */
.step-bar { display: flex; align-items: center; justify-content: center; padding: 24rpx 32rpx 0; background: #1A6DFF; }
.step-item { display: flex; flex-direction: column; align-items: center; }
.step-num { width: 44rpx; height: 44rpx; border-radius: 50%; background: rgba(255,255,255,0.3); color: #fff; font-size: 22rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 6rpx; }
.step-item.active .step-num { background: #fff; color: #1A6DFF; font-weight: bold; }
.step-label { font-size: 20rpx; color: rgba(255,255,255,0.7); }
.step-item.active .step-label { color: #fff; font-weight: 500; }
.step-arrow { color: rgba(255,255,255,0.4); font-size: 28rpx; margin: 0 12rpx; margin-bottom: 24rpx; }


/* 页面容器 */
.page-container { height: calc(100vh - 120rpx); padding: 24rpx 24rpx 40rpx; box-sizing: border-box; }

/* 英雄卡片 */
.hero-card { background: linear-gradient(135deg, #1A6DFF 0%, #4A90D9 100%); border-radius: 20rpx; padding: 40rpx 32rpx; margin-bottom: 24rpx; color: #fff; }
.hero-icon { font-size: 56rpx; margin-bottom: 16rpx; }
.hero-title { font-size: 40rpx; font-weight: bold; margin-bottom: 12rpx; }
.hero-subtitle { font-size: 26rpx; opacity: 0.8; line-height: 1.5; }

/* 通用卡片 */
.card { background: #fff; border-radius: 16rpx; padding: 28rpx 24rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.section-title { font-size: 30rpx; font-weight: bold; color: #1A1A2E; margin-bottom: 20rpx; }

/* 身份选项 */
.identity-option { display: flex; align-items: center; padding: 24rpx 20rpx; border: 2rpx solid #E8E8E8; border-radius: 12rpx; margin-bottom: 16rpx; transition: all 0.2s; }
.identity-option.selected { border-color: #1A6DFF; background: #F0F5FF; }
.role-icon { font-size: 44rpx; margin-right: 20rpx; }
.role-info { flex: 1; }
.role-name { font-size: 28rpx; font-weight: 600; color: #1A1A2E; margin-bottom: 4rpx; }
.role-desc { font-size: 24rpx; color: #888; }
.role-check { width: 40rpx; height: 40rpx; border-radius: 50%; background: #1A6DFF; color: #fff; font-size: 24rpx; display: flex; align-items: center; justify-content: center; }

/* 按钮 */
.btn-next { background: #1A6DFF; color: #fff; border-radius: 12rpx; height: 88rpx; line-height: 88rpx; font-size: 30rpx; font-weight: 600; margin-top: 8rpx; border: none; }
.btn-next[disabled] { background: #C0C0C0; color: #fff; }
