/* pages/s2-identity/index.wxss */
/* S1 登录页 - 与封面页统一风格 - 疏朗居中布局 */

page {
  background: #0a0e1a;
  height: 100%;
}

/* ========= 页面容器 ========== */
.identity-page {
  min-height: 100vh;
  background: #0a0e1a;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;   /* 全局垂直居中 */
  padding-bottom: env(safe-area-inset-bottom);
  position: relative;
}

/* ========= 主内容区（和封面一致：垂直居中+疏朗）========== */
.main-content {
  width: 100%;
  padding: 60rpx 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

/* ========= 标题区（和封面一致）========== */
.title-area {
  text-align: center;
  margin-bottom: 56rpx;
}
.app-name {
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
  margin-bottom: 8rpx;
  letter-spacing: 4rpx;
}
.app-title {
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 6rpx;
  line-height: 1.3;
  text-shadow:
    0 0 20rpx rgba(0, 212, 255, 0.5),
    0 0 40rpx rgba(0, 212, 255, 0.25),
    0 0 80rpx rgba(26, 109, 255, 0.15);
}
.app-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.35);
  margin-top: 14rpx;
  letter-spacing: 2rpx;
}

/* ========= 微信登录按钮（描边风格=封面统一）========== */
.btn-wechat {
  width: 100%;
  height: 96rpx;
  background: transparent;
  color: #1A6DFF;
  border: 2rpx solid #1A6DFF;
  border-radius: 48rpx;        /* 胶囊形，和封面统一 */
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
  padding: 0;
  box-shadow: 0 0 24rpx rgba(26,109,255,0.2);
}
.btn-wechat::after { border: none; }
.btn-wechat:active { background: rgba(26,109,255,0.08); }
.wechat-icon { font-size: 34rpx; }

/* ========= 分隔线 ========== */
.divider {
  display: flex;
  align-items: center;
  width: 100%;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.divider-line {
  flex: 1;
  height: 1rpx;
  background: rgba(255,255,255,0.06);
}
.divider-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.18);
  white-space: nowrap;
}

/* ========= 展开按钮（轻量文字按钮）========== */
.btn-alt {
  width: 100%;
  height: 72rpx;
  background: transparent;
  color: rgba(255,255,255,0.45);
  font-size: 26rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 36rpx;       /* 胶囊形 */
  margin-bottom: 16rpx;
  padding: 0;
}
.btn-alt::after { border: none; }
.btn-alt:active { background: rgba(255,255,255,0.04); }

/* ========= 登录/注册卡片 ========== */
.login-card {
  width: 100%;
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 16rpx;
}
.reg-card { padding-top: 24rpx; }

/* ========= 输入框 ========== */
.login-input {
  width: 100%;
  height: 84rpx;
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.09);
  border-radius: 14rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: #e0e0e0;
  box-sizing: border-box;
  margin-bottom: 18rpx;
}
.login-input:focus {
  border-color: rgba(26,109,255,0.5);
  background: rgba(255,255,255,0.06);
}
.login-input::placeholder { color: rgba(255,255,255,0.15); }
.code-input { flex: 1; margin-bottom: 0; }

.input-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

/* ========= 验证码按钮 ========== */
.btn-code {
  width: 180rpx;
  height: 84rpx;
  background: transparent;
  color: #1A6DFF;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(26,109,255,0.35);
  padding: 0;
  white-space: nowrap;
  flex-shrink: 0;
}
.btn-code[disabled] { color: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.06); }
.btn-code::after { border: none; }

/* ========= 提交按钮 ========== */
.btn-submit {
  width: 100%;
  height: 84rpx;
  background: linear-gradient(135deg, #1A6DFF 0%, #185FA5 100%);
  color: #fff;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-top: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(26,109,255,0.25);
}
.btn-submit[disabled] { background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.15); box-shadow: none; }
.btn-submit::after { border: none; }

/* ========= 注册链接 ========== */
.reg-link-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.25);
}
.reg-action { color: #1A6DFF; font-weight: 500; }

/* ========= 协议提示 ========== */
.agreement {
  font-size: 18rpx;
  color: rgba(255,255,255,0.12);
  text-align: center;
  margin-top: 28rpx;
}

/* ========= 开发模式跳过按钮 ========== */
.btn-skip-login {
  position: fixed;
  right: 24rpx; bottom: 120rpx; z-index: 999;
  background: rgba(0,0,0,0.5);
  color: rgba(0,212,255,0.7);
  font-size: 20rpx;
  padding: 12rpx 22rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(0,212,255,0.25);
  backdrop-filter: blur(10px);
}
.btn-skip-login::after { border: none; }
