/* pages/w3-resource/index.wxss */
/* W3 资源调查页面样式 V2.8 全量版 */

.resource-page {
  min-height: 100vh;
  background: #0a0e1a;
  padding-bottom: 180rpx;
}

/* ========= 步骤条（复用全局） ========= */

/* ========= 雷达图区域 ========= */
.chart-section {
  margin: 24rpx 24rpx 8rpx;
  padding: 28rpx 20rpx 20rpx;
  background: #14182b;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(26, 109, 255, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.chart-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #00D4FF;
  margin-bottom: 12rpx;
}

/* ========= 资源评分条形图（替代 Canvas 雷达图） ========= */
.score-list {
  width: 100%;
  padding: 8rpx 0;
}

.score-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.score-name {
  width: 140rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  text-align: right;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.score-bar-wrap {
  flex: 1;
  height: 32rpx;
  background: #F0F0F0;
  border-radius: 16rpx;
  overflow: hidden;
}

.score-bar {
  height: 100%;
  background: linear-gradient(90deg, #00D4FF, #5B9AFF);
  border-radius: 16rpx;
  transition: width 0.5s ease;
}

.score-value {
  width: 60rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #00D4FF;
  text-align: right;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.score-summary {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #F0F0F0;
  text-align: center;
}

.score-total {
  font-size: 32rpx;
  font-weight: 700;
  color: #00D4FF;
}

/* ========= 页面头部 ========= */
.page-header {
  padding: 32rpx 32rpx 16rpx;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #A0A8B8;
}

.data-source-badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 18rpx;
  background: rgba(0, 212, 255, 0.12);
  border: 1rpx solid rgba(0, 212, 255, 0.25);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #00D4FF;
}

/* ========= 内容容器 ========= */
.page-container {
  padding: 0 24rpx 40rpx;
}

/* ========= 分类标题 ========= */
.category-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #00D4FF;
  margin: 32rpx 0 16rpx 8rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid #D6E4FF;
}

/* ========= 数据卡片（通用） ========= */
.data-card {
  background: #14182b;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.data-card.highlight {
  border-left: 8rpx solid #00D4FF;
  background: #F0F5FF;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}

.card-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex: 1;
}

.data-value {
  display: block;
  font-size: 30rpx;
  color: #FFFFFF;
  line-height: 1.8;
  margin-top: 8rpx;
}

/* ========= 来源标签 ========= */
.source-tag {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.source-tag.official {
  background: rgba(0, 212, 255, 0.12);
  border: 1rpx solid rgba(0, 212, 255, 0.25);
  color: #00D4FF;
}

.source-tag.ai {
  background: rgba(0, 179, 101, 0.12);
  border: 1rpx solid rgba(0, 179, 101, 0.25);
  color: #00B365;
}

.source-tag.manual {
  background: rgba(245, 166, 35, 0.12);
  border: 1rpx solid rgba(245, 166, 35, 0.25);
  color: #F5A623;
}

/* ========= 人工备注 ========= */
.manual-note {
  display: flex;
  align-items: flex-start;
  margin-top: 10rpx;
  padding: 8rpx 12rpx;
  background: rgba(245, 166, 35, 0.08);
  border: 1rpx solid rgba(245, 166, 35, 0.15);
  border-radius: 8rpx;
  gap: 6rpx;
}

.manual-note .note-icon {
  font-size: 22rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.manual-note .note-text {
  flex: 1;
  font-size: 22rpx;
  color: #D4A853;
  line-height: 1.5;
}

.manual-note .note-edit {
  font-size: 20rpx;
  color: rgba(0, 212, 255, 0.5);
  flex-shrink: 0;
  padding: 2rpx 8rpx;
}

/* ========= 编辑按钮 ========= */
.edit-btn-wrap {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.edit-btn {
  background: #1e2335;
  color: #00D4FF;
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  border: none;
  line-height: 1.6;
}

.edit-btn::after {
  border: none;
}

/* ========= 确认区域 ========= */
.confirm-section {
  margin-top: 40rpx;
  padding: 32rpx 24rpx;
  background: #14182b;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.confirm-checkbox {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 3rpx solid #C8C8CC;
  margin-right: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFFFFF;
  transition: all 0.2s;
}

.checkbox.checked {
  background: #00D4FF;
  border-color: #00D4FF;
}

.confirm-text {
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1.6;
}

.next-btn {
  width: 100%;
  height: 88rpx;
  background: #C8C8CC;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 12rpx;
  border: none;
  line-height: 88rpx;
}

.next-btn:not(.disabled) {
  background: #00D4FF;
}

.next-btn.disabled {
  background: #C8C8CC;
}

.next-btn::after {
  border: none;
}

/* ========= 地块信息卡片（从W1传入） ========= */
.land-info-card {
  margin: 0 24rpx 24rpx;
  padding: 24rpx 28rpx;
  background: #14182b;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
  border-left: 8rpx solid #00D4FF;
}

.land-info-card.empty {
  border-left-color: #F5A623;
  background: #FFFBF5;
}

.land-info-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}

.land-info-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #00D4FF;
}

.land-info-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  text-align: right;
  flex: 1;
}

.land-info-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.land-info-row:last-child {
  border-bottom: none;
}

.land-info-label {
  font-size: 26rpx;
  color: #A0A8B8;
  width: 140rpx;
  flex-shrink: 0;
}

/* ========= 地块信息卡片（从W1传入） ========= */
.land-info-card {
  margin: 0 24rpx 24rpx;
  padding: 24rpx 28rpx;
  background: #14182b;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
  border-left: 8rpx solid #00D4FF;
}

.land-info-card.empty {
  border-left-color: #F5A623;
  background: #FFFBF5;
}

.land-info-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}

.land-info-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #00D4FF;
}

.land-info-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  text-align: right;
  flex: 1;
}

.land-info-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.land-info-row:last-child {
  border-bottom: none;
}

.land-info-label {
  font-size: 26rpx;
  color: #A0A8B8;
  width: 140rpx;
  flex-shrink: 0;
}

.land-info-value {
  font-size: 26rpx;
  color: #FFFFFF;
  flex: 1;
  line-height: 1.5;
}

/* ========= 展开/折叠功能 ========= */
.data-value.summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1.6;
  margin-top: 8rpx;
}

.expand-btn,
.collapse-btn {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 20rpx;
  background: #1e2335;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #00D4FF;
  text-align: center;
}

.expand-btn:active,
.collapse-btn:active {
  background: #E0E8FF;
}

/* ========= 溯源信息样式 ========= */
.source-trace {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #F8FAFB;
  border-radius: 12rpx;
  border-left: 6rpx solid #00D4FF;
}

.trace-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #E8E8E8;
  margin-bottom: 12rpx;
}

.trace-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #00D4FF;
}

.trace-toggle {
  font-size: 24rpx;
  color: #A0A8B8;
  padding: 4rpx 12rpx;
  background: #14182b;
  border-radius: 6rpx;
}

.trace-content {
  padding-top: 8rpx;
}

.trace-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.trace-item:last-child {
  border-bottom: none;
}

.trace-type {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  font-weight: 600;
}

.trace-type.official {
  background: rgba(0, 212, 255, 0.12);
  border: 1rpx solid rgba(0, 212, 255, 0.25);
  color: #00D4FF;
}

.trace-type.ai {
  background: rgba(0, 179, 101, 0.12);
  border: 1rpx solid rgba(0, 179, 101, 0.25);
  color: #00B365;
}

.trace-type.manual {
  background: rgba(245, 166, 35, 0.12);
  border: 1rpx solid rgba(245, 166, 35, 0.25);
  color: #F5A623;
}

.trace-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.trace-name {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.trace-confidence {
  font-size: 22rpx;
  color: #A0A8B8;
}

.trace-url {
  font-size: 22rpx;
  color: #00D4FF;
  margin-top: 4rpx;
  word-break: break-all;
}

.trace-url:active {
  color: #0052CC;
  text-decoration: underline;
}

/* ========= V2.2.0 精修覆盖层（发光+玻璃态+胶囊按钮+白色步骤） ========= */
page .step-bar-scroll { background: #0a0e1a !important; }
page .step-item.active .step-num { background: #FFFFFF !important; color: #0a0e1a !important; }
page .step-item.active .step-label { color: #FFFFFF !important; font-weight: 700 !important; }
page .page-title, page .chart-title, page .card-label { text-shadow: 0 0 10px rgba(0, 212, 255, 0.3), 0 0 30px rgba(0, 212, 255, 0.1) !important; }
page .chart-section, page .data-card, page .land-info-card { background: rgba(20, 24, 43, 0.6) !important; border: 1px solid rgba(0, 212, 255, 0.15) !important; box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.05) !important; }
page .data-source-badge { background: rgba(0, 212, 255, 0.1) !important; border: 1px solid rgba(0, 212, 255, 0.2) !important; }
page .next-btn { border-radius: 48rpx !important; background: linear-gradient(135deg, rgba(0, 212, 255, 0.15) 0%, rgba(0, 136, 204, 0.15) 100%) !important; color: #00D4FF !important; border: 1px solid rgba(0, 212, 255, 0.3) !important; box-shadow: 0 0 15px rgba(0, 212, 255, 0.15) !important; }
