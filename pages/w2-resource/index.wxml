          <text class="data-value summary">{{item.value.split('\\n')[0]}}...</text>
          <view class="expand-btn" bindtap="onToggleExpand" data-key="{{item.key}}">
            <text>展开详情 ▼</text>
          </view>
        </view>

        <view wx:if="{{expandedItems[item.key]}}">
          <text class="data-value" user-select="true">{{item.value}}</text>

          <view class="source-trace" wx:if="{{item.sources && item.sources.length > 0}}">
            <view class="trace-header" bindtap="onToggleExpand" data-key="{{item.key}}-trace">
              <text class="trace-title">📊 数据溯源</text>
              <text class="trace-toggle">{{expandedItems[item.key + '-trace'] ? '收起 ▲' : '展开 ▼'}}</text>
            </view>
            <view class="trace-content" wx:if="{{expandedItems[item.key + '-trace']}}">
              <view class="trace-item" wx:for="{{item.sources}}" wx:key="type">
                <view class="trace-type {{item.type === '官方API' ? 'official' : (item.type === '人工' ? 'manual' : 'ai')}}">
                  {{item.type}}
                </view>
                <view class="trace-detail">
                  <text class="trace-name">{{item.name}}</text>
                  <text class="trace-confidence">置信度：{{item.confidence}}</text>
                  <view class="trace-url" wx:if="{{item.url}}" bindtap="onCopyUrl" data-url="{{item.url}}">
                    <text>🔗 {{item.url}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <view class="collapse-btn" bindtap="onToggleExpand" data-key="{{item.key}}">
            <text>收起 ▲</text>
          </view>
        </view>

        <view class="manual-note" wx:if="{{item.manualNote}}">
          <text class="note-icon">📝</text>
          <text class="note-text">{{item.manualNote}}</text>
          <text class="note-edit" catchtap="onEditItem" data-key="{{item.key}}">✏️</text>
        </view>
      </view>
    </block>

    <!-- ========== 9. 人文活动 ========== -->
    <view class="category-title">🎭 人文活动</view>
    <block wx:for="{{cultureList}}" wx:key="key">
      <view class="data-card">
        <view class="card-header">
          <text class="card-label" user-select="true">{{item.label}}</text>
          <view class="source-tag {{item.sourceType === 'official_api' ? 'official' : (item.sourceType === 'manual' ? 'manual' : 'ai')}}">
            {{item.sourceType === 'official_api' ? '官方API' : (item.sourceType === 'manual' ? '人工' : 'AI聚合')}}
          </view>
        </view>

        <view wx:if="{{!expandedItems[item.key]}}">
          <text class="data-value summary">{{item.value.split('\\n')[0]}}...</text>
          <view class="expand-btn" bindtap="onToggleExpand" data-key="{{item.key}}">
            <text>展开详情 ▼</text>
          </view>
        </view>

        <view wx:if="{{expandedItems[item.key]}}">
          <text class="data-value" user-select="true">{{item.value}}</text>

          <view class="source-trace" wx:if="{{item.sources && item.sources.length > 0}}">
            <view class="trace-header" bindtap="onToggleExpand" data-key="{{item.key}}-trace">
              <text class="trace-title">📊 数据溯源</text>
              <text class="trace-toggle">{{expandedItems[item.key + '-trace'] ? '收起 ▲' : '展开 ▼'}}</text>
            </view>
            <view class="trace-content" wx:if="{{expandedItems[item.key + '-trace']}}">
              <view class="trace-item" wx:for="{{item.sources}}" wx:key="type">
                <view class="trace-type {{item.type === '官方API' ? 'official' : (item.type === '人工' ? 'manual' : 'ai')}}">
                  {{item.type}}
                </view>
                <view class="trace-detail">
                  <text class="trace-name">{{item.name}}</text>
                  <text class="trace-confidence">置信度：{{item.confidence}}</text>
                  <view class="trace-url" wx:if="{{item.url}}" bindtap="onCopyUrl" data-url="{{item.url}}">
                    <text>🔗 {{item.url}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <view class="collapse-btn" bindtap="onToggleExpand" data-key="{{item.key}}">
            <text>收起 ▲</text>
          </view>
        </view>

        <view class="manual-note" wx:if="{{item.manualNote}}">
          <text class="note-icon">📝</text>
          <text class="note-text">{{item.manualNote}}</text>
          <text class="note-edit" catchtap="onEditItem" data-key="{{item.key}}">✏️</text>
        </view>
      </view>
    </block>

    <!-- ========== 10. 资源综合评价 ========== -->
    <view class="category-title">📊 资源综合评价</view>
    <view class="data-card highlight">
      <view class="card-header">
        <text class="card-label" user-select="true">资源综合评价（人工汇总）</text>
        <view class="source-tag manual">人工汇总</view>
      </view>

      <view wx:if="{{!expandedItems['resourceSummary']}}">
        <text class="data-value summary">{{resourceSummaryValue.split('\\n')[0]}}...</text>
        <view class="expand-btn" bindtap="onToggleExpand" data-key="resourceSummary">
          <text>展开详情 ▼</text>
        </view>
      </view>

      <view wx:if="{{expandedItems['resourceSummary']}}">
        <text class="data-value" user-select="true">{{resourceSummaryValue}}</text>
        <view class="collapse-btn" bindtap="onToggleExpand" data-key="resourceSummary">
          <text>收起 ▲</text>
        </view>
      </view>

      <view class="manual-note" wx:if="{{resourceSummaryManualNote}}">
          <text class="note-icon">📝</text>
          <text class="note-text">{{resourceSummaryManualNote}}</text>
          <text class="note-edit" catchtap="onEditItem" data-key="resourceSummary">✏️</text>
        </view>
    </view>

    <!-- 确认按钮 -->
    <view class="confirm-section">
      <view class="confirm-checkbox" bindtap="onToggleConfirm">
        <view class="checkbox {{isConfirmed ? 'checked' : ''}}">
          <text wx:if="{{isConfirmed}}">✓</text>
        </view>
        <text class="confirm-text" user-select="true">{{confirmText}}</text>
      </view>
      <button class="next-btn {{isConfirmed ? '' : 'disabled'}}" bindtap="onNext" disabled="{{!isConfirmed}}">
        确认并继续 →
      </button>
    </view>

  </view>
</view>
