/* pages/w8-demand/index.wxss */
/* W8 需求澄清页面样式 V2.8 全量版 */

.demand-page {
  min-height: 100vh;
  background: #0a0e1a;
  padding-bottom: 180rpx;
}

/* ========= 步骤条（复用全局） ========= */

/* ========= 页面头部 ========= */
.page-header {
  padding: 32rpx 32rpx 16rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #A0A8B8;
}

.data-source-badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  background: #E8F4FD;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #00D4FF;
}

/* ========= 内容容器 ========= */
.page-container {
  padding: 0 24rpx 40rpx;
}

/* ========= 区块卡片 ========= */
.section-card {
  background: #14182b;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #D6E4FF;
}

/* ========= 表单项 ========= */
.form-item {
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.form-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.form-question {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

/* ========= Radio 选项 ========= */
.radio-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.radio-option {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #F8F9FA;
  border-radius: 10rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.radio-option.selected {
  background: #E8F4FD;
  border-color: #00D4FF;
}

.radio-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid #C8C8CC;
  margin-right: 16rpx;
  flex-shrink: 0;
  position: relative;
}

.radio-option.selected .radio-dot {
  border-color: #00D4FF;
}

.radio-option.selected .radio-dot::after {
  content: '';
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  background: #00D4FF;
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* ========= Checkbox 选项（优势资源） ========= */
.check-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 16rpx;
  margin-bottom: 16rpx;
  background: #F8F9FA;
  border-radius: 12rpx;
}

.check-item:last-child {
  margin-bottom: 0;
}

.check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 3rpx solid #C8C8CC;
  margin-right: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
  transition: all 0.2s;
  margin-top: 4rpx;
}

.check-box.checked {
  background: #00D4FF;
  border-color: #00D4FF;
}

.check-content {
  flex: 1;
}

.check-label {
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.tag-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

/* ========= 来源标签 ========= */
.source-tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.source-tag.official {
  background: #E8F4FD;
  color: #00D4FF;
}

.source-tag.ai {
  background: #E8F7ED;
  color: #00B365;
}

.source-tag.manual {
  background: #FFF3E0;
  color: #F5A623;
}

/* ========= 人工备注 ========= */
.manual-note {
  display: block;
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #FFF8F0;
  border-left: 6rpx solid #F5A623;
  border-radius: 0 8rpx 8rpx 0;
  font-size: 22rpx;
  color: #8C6900;
  line-height: 1.6;
}

/* ========= 编辑按钮 ========= */
.edit-btn-wrap {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.edit-btn {
  background: #1e2335;
  color: #00D4FF;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  border: none;
  line-height: 1.6;
}

.edit-btn::after {
  border: none;
}

/* ========= 确认区域 ========= */
.confirm-section {
  margin-top: 40rpx;
  padding: 32rpx 24rpx;
  background: #14182b;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.confirm-checkbox {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 3rpx solid #C8C8CC;
  margin-right: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFFFFF;
  transition: all 0.2s;
}

.checkbox.checked {
  background: #00D4FF;
  border-color: #00D4FF;
}

.confirm-text {
  font-size: 26rpx;
  color: #FFFFFF;
  line-height: 1.6;
}

.next-btn {
  width: 100%;
  height: 88rpx;
  background: #C8C8CC;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 12rpx;
  border: none;
  line-height: 88rpx;
}

.next-btn:not(.disabled) {
  background: #00D4FF;
}

.next-btn.disabled {
  background: #C8C8CC;
}

.next-btn::after {
  border: none;
}

/* ========= 总投预算阶梯 ========= */
.radio-other {
  flex-wrap: wrap;
  align-items: center;
}
.inline-input {
  flex: 1;
  min-width: 200rpx;
  height: 64rpx;
  padding: 0 16rpx;
  background: #14182b;
  border: 2rpx solid #D6E4FF;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  margin-left: 12rpx;
}
.item-remark {
  margin-top: 16rpx;
}
.remark-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  background: #F8F9FA;
  border: 2rpx solid #E8E8E8;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  box-sizing: border-box;
}

/* ========= 其他优势条件补充 ========= */
.advantage-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.advantage-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.advantage-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #00D4FF;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 18rpx;
}
.advantage-input-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}
.advantage-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: #F8F9FA;
  border: 2rpx solid #E8E8E8;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  box-sizing: border-box;
}
.advantage-delete {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #FFF0F0;
  color: #E53935;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 16rpx;
}

/* ========= 增加按钮 ========= */
.add-btn-wrap {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}
.add-btn {
  background: #1e2335;
  color: #00D4FF;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  border: none;
  line-height: 1.6;
}
.add-btn::after {
  border: none;
}

/* ========= V2.2.0 精修覆盖层（发光+玻璃态+胶囊按钮+白色步骤） ========= */
.step-bar-scroll { background: #0a0e1a !important; }
.step-item.active .step-num { background: #FFFFFF !important; color: #0a0e1a !important; }
.step-item.active .step-label { color: #FFFFFF !important; font-weight: 700 !important; }
.page-title { text-shadow: 0 0 10px rgba(0, 212, 255, 0.3), 0 0 30px rgba(0, 212, 255, 0.1) !important; }
.card, .map-section, .coord-section, .summary-card, .info-card, .swot-card, .demand-card, .position-card, .result-card, .report-card, .resource-card, .policy-card, .market-card, .redline-card { background: rgba(20, 24, 43, 0.6) !important; border: 1px solid rgba(0, 212, 255, 0.15) !important; box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.05) !important; }
.card-title, .summary-title, .coord-section-title { text-shadow: 0 0 8px rgba(0, 212, 255, 0.2) !important; }
.data-source-badge, .summary-badge, .badge { background: rgba(0, 212, 255, 0.1) !important; border: 1px solid rgba(0, 212, 255, 0.2) !important; }
.btn-next { border-radius: 48rpx !important; background: linear-gradient(135deg, rgba(0, 212, 255, 0.15) 0%, rgba(0, 136, 204, 0.15) 100%) !important; color: #00D4FF !important; border: 1px solid rgba(0, 212, 255, 0.3) !important; box-shadow: 0 0 15px rgba(0, 212, 255, 0.15) !important; }
.map-toolbar { background: rgba(20, 24, 43, 0.6) !important; border-top: 1px solid rgba(0, 212, 255, 0.1) !important; }
