/* pages/w9-position/index.wxss */
/* W9 战略定位页面样式 V2.8 全量版 */

.position-page {
  min-height: 100vh;
  background: #0a0e1a;
  padding-bottom: 180rpx;
}

/* ========= 步骤条（复用全局） ========= */

/* ========= 页面头部 ========= */
.page-header {
  padding: 32rpx 32rpx 16rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #A0A8B8;
}

.data-source-badge {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  background: rgba(0, 212, 255, 0.12);
  border: 1rpx solid rgba(0, 212, 255, 0.25);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #00D4FF;
}

/* ========= 内容容器 ========= */
.page-container {
  padding: 0 24rpx 40rpx;
}

/* ========= 区块卡片 ========= */
.section-card {
  background: #14182b;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #D6E4FF;
}

/* ========= 数据盘存摘要 ========= */
.summary-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 12rpx;
  margin-bottom: 12rpx;
  background: #14182b;
  border-radius: 10rpx;
}

.summary-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  white-space: nowrap;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.summary-value {
  font-size: 26rpx;
  color: #A0A8B8;
  line-height: 1.6;
  flex: 1;
}

.warning-text {
  color: #F5A623;
  font-weight: 600;
}

/* ========= 项目命名 ========= */
.naming-card {
  background: #14182b;
  border: 1rpx solid rgba(0, 212, 255, 0.15);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.naming-result {
  padding: 20rpx 16rpx;
  margin-bottom: 16rpx;
}

.project-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #00D4FF;
  margin-bottom: 12rpx;
}

.project-slogan {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #00B365;
  margin-bottom: 16rpx;
}

.naming-logic {
  display: block;
  font-size: 22rpx;
  color: #A0A8B8;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

/* ========= 三级建议方案 ========= */
.rec-card {
  background: #14182b;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
  border-left: 8rpx solid #C8C8CC;
}

.rec-best {
  border-left-color: #00B365;
}

.rec-mid {
  border-left-color: #00D4FF;
}

.rec-worst {
  border-left-color: #E53935;
}

.rec-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.rec-tag {
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.tag-green {
  background: rgba(0, 179, 101, 0.12);
  border: 1rpx solid rgba(0, 179, 101, 0.25);
  color: #00B365;
}

.tag-blue {
  background: rgba(0, 212, 255, 0.12);
  border: 1rpx solid rgba(0, 212, 255, 0.25);
  color: #00D4FF;
}

.tag-orange {
  background: rgba(245, 166, 35, 0.12);
  border: 1rpx solid rgba(245, 166, 35, 0.25);
  color: #F5A623;
}

.rec-level {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.rec-strategy {
  font-size: 26rpx;
  color: #FFFFFF;
  line-height: 1.8;
  margin-bottom: 16rpx;
}

.rec-sub-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
  margin-top: 8rpx;
}

.rec-highlight {
  font-size: 24rpx;
  color: #00B365;
  line-height: 1.8;
  padding-left: 8rpx;
}

.rec-risk {
  font-size: 24rpx;
  color: #E53935;
  line-height: 1.8;
  padding-left: 8rpx;
}

/* ========= 人工备注 ========= */
.manual-note {
  display: block;
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: rgba(245, 166, 35, 0.12);
  border: 1rpx solid rgba(245, 166, 35, 0.25);
  border-left: 6rpx solid #F5A623;
  border-radius: 0 8rpx 8rpx 0;
  font-size: 22rpx;
  color: #8C6900;
  line-height: 1.6;
}

/* ========= 编辑按钮 ========= */
.edit-btn-wrap {
  display: flex;
  justify-content: flex-end;
}

.edit-btn {
  background: #1e2335;
  color: #00D4FF;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  border: none;
  line-height: 1.6;
}

.edit-btn::after {
  border: none;
}

/* ========= 漏斗图区域（WXML 因果关系布局） ========= */
.chart-section {
  margin: 24rpx 24rpx 0;
  background: #14182b;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.chart-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #00D4FF;
  margin-bottom: 12rpx;
}

.filter-hint {
  display: block;
  font-size: 22rpx;
  color: #A0A8B8;
  margin-bottom: 16rpx;
}

.filter-list {
  padding: 0 0 8rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.filter-bar-bg {
  flex: 1;
  height: 56rpx;
  background: #0a0e1a;
  border-radius: 10rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.filter-bar {
  height: 100%;
  border-radius: 10rpx;
  border-left: 6rpx solid;
  display: flex;
  align-items: center;
  padding-left: 20rpx;
  transition: width 0.4s ease;
  min-width: 35%;
}

.filter-name {
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.filter-rate {
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
  min-width: 80rpx;
  text-align: right;
}

.conv-row {
  display: flex;
  justify-content: center;
  padding: 4rpx 0 4rpx 180rpx;
}

.conv-text {
  font-size: 22rpx;
  color: #A0A8B8;
  background: #0a0e1a;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.divider-line {
  height: 2rpx;
  background: linear-gradient(to right, transparent, #D6E4FF, transparent);
  margin: 20rpx 0 12rpx;
}

.divider-text {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #A0A8B8;
  margin-bottom: 16rpx;
}

.result-card {
  background: linear-gradient(135deg, #00D4FF 0%, #4A90D9 100%);
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(26, 109, 255, 0.25);
}

.result-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.result-step {
  font-size: 24rpx;
  opacity: 0.85;
}

.result-label {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.result-value {
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1.1;
  margin-bottom: 8rpx;
}

.result-hint {
  font-size: 22rpx;
  opacity: 0.75;
}

.chart-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #A0A8B8;
  line-height: 1.6;
}

/* ========= 确认区域 ========= */
.confirm-section {
  margin-top: 40rpx;
  padding: 32rpx 24rpx;
  background: #14182b;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.confirm-checkbox {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 3rpx solid #C8C8CC;
  margin-right: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFFFFF;
  transition: all 0.2s;
}

.checkbox.checked {
  background: #00D4FF;
  border-color: #00D4FF;
}

.confirm-text {
  font-size: 26rpx;
  color: #FFFFFF;
  line-height: 1.6;
}

.next-btn {
  width: 100%;
  height: 88rpx;
  background: #C8C8CC;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 12rpx;
  border: none;
  line-height: 88rpx;
}

.next-btn:not(.disabled) {
  background: #00D4FF;
}

.next-btn.disabled {
  background: #C8C8CC;
}

.next-btn::after {
  border: none;
}

/* ========= V2.2.0 精修覆盖层（发光+玻璃态+胶囊按钮+白色步骤） ========= */
page .step-bar-scroll { background: #0a0e1a !important; }
page .step-item.active .step-num { background: #FFFFFF !important; color: #0a0e1a !important; }
page .step-item.active .step-label { color: #FFFFFF !important; font-weight: 700 !important; }
page .page-title, page .section-title, page .chart-title { text-shadow: 0 0 10px rgba(0, 212, 255, 0.3), 0 0 30px rgba(0, 212, 255, 0.1) !important; }
page .section-card, page .naming-card, page .rec-card, page .chart-section { background: rgba(20, 24, 43, 0.6) !important; border: 1px solid rgba(0, 212, 255, 0.15) !important; box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.05) !important; }
page .data-source-badge { background: rgba(0, 212, 255, 0.1) !important; border: 1px solid rgba(0, 212, 255, 0.2) !important; }
page .next-btn { border-radius: 48rpx !important; background: linear-gradient(135deg, rgba(0, 212, 255, 0.15) 0%, rgba(0, 136, 204, 0.15) 100%) !important; color: #00D4FF !important; border: 1px solid rgba(0, 212, 255, 0.3) !important; box-shadow: 0 0 15px rgba(0, 212, 255, 0.15) !important; }
