<!--pages/w8-position/index.wxml-->
<view class="position-page">

  <!-- 步骤条 -->
    <scroll-view scroll-x class="step-bar-scroll" enhanced show-scrollbar="{{false}}">
    <view class="step-bar">
      <view class="step-item"><view class="step-num">W1</view><text class="step-label">地块</text></view>
      <text class="step-arrow">→</text>
      <view class="step-item"><view class="step-num">W2</view><text class="step-label">资源</text></view>
      <text class="step-arrow">→</text>
      <view class="step-item"><view class="step-num">W3</view><text class="step-label">政策</text></view>
      <text class="step-arrow">→</text>
      <view class="step-item"><view class="step-num">W4</view><text class="step-label">市场</text></view>
      <text class="step-arrow">→</text>
      <view class="step-item"><view class="step-num">W5</view><text class="step-label">法规</text></view>
      <text class="step-arrow">→</text>
      <view class="step-item"><view class="step-num">W6</view><text class="step-label">SWOT</text></view>
      <text class="step-arrow">→</text>
      <view class="step-item"><view class="step-num">W7</view><text class="step-label">需求</text></view>
      <text class="step-arrow">→</text>
      <view class="step-item active"><view class="step-num">W8</view><text class="step-label">定位</text></view>
      <text class="step-arrow">→</text>
      <view class="step-item"><view class="step-num">W9</view><text class="step-label">成果</text></view>
    </view>
  </scroll-view>

  <!-- 页面头部 -->
  <view class="page-header">
    <view class="page-title">W8 战略定位建议书</view>
    <view class="page-subtitle">基于 W2-W7 数据盘存的综合定位建议</view>
  </view>

  <view class="page-container">

    <!-- 数据盘存摘要 -->
    <view class="section-card">
      <view class="section-title">📦 数据盘存摘要</view>
      <view class="summary-row">
        <text class="summary-label">🗺️ 地块</text>
        <text class="summary-value">{{dataSummary.land}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-label">🌿 资源</text>
        <text class="summary-value">{{dataSummary.resource}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-label">📋 政策</text>
        <text class="summary-value">{{dataSummary.policy}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-label">📈 市场</text>
        <text class="summary-value">{{dataSummary.market}}</text>
      </view>
      <view class="summary-row warning">
        <text class="summary-label">🚨 合规</text>
        <text class="summary-value">{{dataSummary.regulation}}</text>
      </view>
      <view class="summary-row">
        <text class="summary-label">🎯 诉求</text>
        <text class="summary-value">{{dataSummary.demand}}</text>
      </view>
    </view>

    <!-- 漏斗图（因果关系布局） -->
    <view class="chart-section">
      <view class="chart-title">🔻 地块筛选漏斗</view>
      <view class="filter-hint">过滤过程（参考值）</view>

      <view class="filter-list">
        <block wx:for="{{filterData}}" wx:key="name" wx:for-index="idx">
          <view class="filter-row">
            <view class="filter-bar-bg">
              <view class="filter-bar" style="width:{{item.widthRate}}%;background:{{item.bgColor}};border-color:{{item.color}};">
                <text class="filter-name" style="color:{{item.color}};">{{item.name}}</text>
              </view>
            </view>
            <text class="filter-rate" style="color:{{item.color}};">{{item.rate}}</text>
          </view>
          <view class="conv-row" wx:if="{{idx < 4}}">
            <text class="conv-text">↓ -{{conversionRates[idx].dropRate}}%</text>
          </view>
        </block>
      </view>

      <view class="divider-line"></view>
      <view class="divider-text">经过上述 5 层过滤，筛选得出</view>

      <view class="result-card">
        <view class="result-header">
          <text class="result-step">6 最终推荐方案</text>
          <text class="result-label">{{resultData.label}}</text>
        </view>
        <view class="result-value">{{resultData.rate}}</view>
        <view class="result-hint">从 100% 初始地块 到 {{resultData.rate}} 最终方案</view>
      </view>

      <view class="chart-hint">💡 从初始地块到最终推荐方案，经过合规性、空间适配、经济可行性、市场需求四层过滤</view>
    </view>

    <!-- 确认按钮 -->
    <view class="confirm-section">
      <view class="confirm-checkbox" bindtap="onToggleConfirm">
        <view class="checkbox {{isConfirmed ? 'checked' : ''}}">
          <text wx:if="{{isConfirmed}}">✓</text>
        </view>
        <text class="confirm-text">{{confirmText}}</text>
      </view>
      <button class="next-btn {{isConfirmed ? '' : 'btn-disabled'}}" bindtap="onNext">
        确认并继续 →
      </button>
    </view>

  </view>
</view>
